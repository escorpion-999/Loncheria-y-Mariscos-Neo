  { id: "refrescos", nombre: "Refrescos", precio: "$25", imagen: "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?auto=format&fit=crop&w=500&q=80" },
  { id: "agua-fresca-medio", nombre: "Agua Fresca 1/2 Litro", precio: "$20", imagen: "https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?auto=format&fit=crop&w=500&q=80" },
